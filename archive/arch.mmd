graph TB
    subgraph "表现层 (UI Layer)"
        UI[Vue组件<br/>页面布局<br/>用户交互]
    end

    subgraph "业务逻辑层 (Business Logic Layer)"
        BL[Vue组件逻辑<br/>事件处理<br/>数据转换]
    end

    subgraph "状态管理层 (State Management Layer)"
        SM[Pinia Store<br/>UserStore<br/>ProductStore<br/>FavoriteStore<br/>AlertStore]
    end

    subgraph "服务层 (Service Layer)"
        API[API服务<br/>ProductApi<br/>UserApi<br/>HTTP客户端]
    end

    subgraph "工具层 (Utils Layer)"
        UT[工具函数<br/>常量配置<br/>类型定义<br/>格式化函数]
    end

    UI --> BL
    BL --> SM
    SM --> API
    API --> UT
