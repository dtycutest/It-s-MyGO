# MySQL persistence
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=onebuy
CRAWLER_ENABLE_MYSQL=1

# Crawl behavior
CRAWLER_DOWNLOAD_DELAY=3.0
CRAWLER_OBEY_ROBOTS=1
CRAWLER_PROXY_LIST=
CRAWLER_PROXY_FILE=
CRAWLER_PROXY_MAX_FAILS=3
CRAWLER_PROXY_COOLDOWN_SECONDS=300
CRAWLER_PROXY_REQUIRED=0
CRAWLER_USE_COOKIES=0

# Optional image cache. Keep disabled unless your backend serves this folder.
CRAWLER_CACHE_IMAGES=0
CRAWLER_IMAGE_STORE=output/product_images
CRAWLER_IMAGE_PUBLIC_BASE_URL=
CRAWLER_IMAGE_TIMEOUT=10

# Optional manual login cookies. Keep CRAWLER_USE_COOKIES=0 to disable them.
JD_COOKIE=
TAOBAO_COOKIE=
JD_COOKIE_FILE=cookies/jd.cookie
TAOBAO_COOKIE_FILE=cookies/taobao.cookie
